__pycache__/
*.pyc
.venv/
firmware/.pio/
firmware/include/
# phone photos dropped into the repo root (they live in data/photos/, which is ignored with data/)
/IMG_*
runs/
datasets/
data/
tools/yibu/artifacts/
models/*.pt
*.pt
targets/*.png
sim_out/
.DS_Store
# calib/: the laptop webcam's intrinsics and the rigid mat board's survey ARE committed (one device, one board, done once).
# Anything else (a phone's intrinsics, per-room extrinsics) stays local.
calib/*
!calib/laptop_intrinsics.npz
!calib/mat.json
!calib/MEASUREMENTS.md
# which firmware letter is which motor (tools/motor_map.py): one box, every laptop needs it
!calib/motor_map.json

.env
.env.*
!.env.example
