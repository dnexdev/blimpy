# Copy to .env (gitignored) and fill in. Loaded by laptop/__init__.py; a variable set in the shell wins over this file.

# Sponsored OMNI key from the approval e-mail. Only its last 4 characters ever reach the usage ledger.
YIBU_API_KEY=

# Relay base URL. Fills in OMNI_HTTP (this value) and OMNI_URL (wss://.../v1/realtime).
OMNI_BASE_URL=https://yibuapi.com/v1

# This machine's room camera (only when it is NOT the Windows demo laptop, whose calibration is committed):
# BLIMPY_CALIB_A=macbook          # uses calib/macbook_intrinsics.npz (python tools/calib/intrinsics.py --name macbook)
# BLIMPY_DEVICE=mps               # detector device: mps on a Mac (4 Hz -> 15+ Hz), leave unset on a CUDA laptop

# Optional overrides (defaults shown)
# OMNI_MODEL=qwen3.5-omni-plus-realtime
# OMNI_WATCH_MODEL=qwen3.5-omni-flash
# OMNI_VOICE=Tina
# YIBU_AUDIT_LOG=data/omni_usage.jsonl
